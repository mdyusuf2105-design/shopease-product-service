APP_NAME=ShopEase Authentication Service
APP_VERSION=1.0.0
APP_PORT=8002

MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MYSQL_DATABASE=shopease_auth_db
MYSQL_USER=CHANGE_ME_DB_USER
MYSQL_PASSWORD=CHANGE_ME_DB_PASSWORD

DATABASE_URL=mysql+pymysql://CHANGE_ME_DB_USER:CHANGE_ME_DB_PASSWORD@db:3306/shopease_auth_db

JWT_SECRET_KEY=REPLACE_WITH_THE_SAME_STRONG_RANDOM_SECRET_USED_BY_USER_SERVICE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
