APP_NAME=ShopEase Product Catalog Service
APP_VERSION=1.0.0
APP_PORT=8005

MYSQL_ROOT_PASSWORD=your_root_password
MYSQL_DATABASE=shopease_product_catalog_db
MYSQL_USER=shopease_catalog
MYSQL_PASSWORD=your_catalog_password

